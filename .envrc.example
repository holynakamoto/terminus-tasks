# Use Portkey for this project
# Copy this file to .envrc and fill in your actual API key
export PORTKEY_API_KEY=your_portkey_api_key_here

# OpenAI via Portkey
export OPENAI_API_KEY=$PORTKEY_API_KEY
export OPENAI_BASE_URL=https://api.portkey.ai/v1

# Anthropic via Portkey
export ANTHROPIC_API_KEY=$PORTKEY_API_KEY
export ANTHROPIC_BASE_URL=https://api.portkey.ai/v1
export ANTHROPIC_PORTKEY_API_KEY=$PORTKEY_API_KEY

# LiteLLM headers for Portkey (will be interpolated at runtime)
export LITELLM_EXTRA_HEADERS='{"x-portkey-api-key": "'$PORTKEY_API_KEY'", "x-portkey-virtual-key": "'$PORTKEY_API_KEY'"}'

# Suppress LiteLLM warnings
export LITELLM_LOG_LEVEL=ERROR
